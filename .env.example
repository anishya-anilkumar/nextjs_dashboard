# PostgreSQL connection string (Vercel Postgres / Neon / Supabase / local).
# Hosted providers usually require ?sslmode=require
POSTGRES_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Only needed for `npm run db:seed` — password for the demo user (demo@example.com).
# Choose your own; it is never committed or hardcoded.
SEED_DEMO_PASSWORD="choose-a-demo-password"

# Self-hosting only (`next start`, Docker, etc.): Auth.js rejects unknown Host
# headers unless you opt in. Vercel sets this up automatically — leave it unset there.
# Only enable when running behind a proxy that sets/validates the Host header.
# AUTH_TRUST_HOST="true"
